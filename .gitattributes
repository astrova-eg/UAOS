# Universal Agent Operating System (UAOS) - Git Attributes & Export Exclusions

# Release Archive Exclusions (Composer archive / Git archive)
/.agents            export-ignore
/.agent-os          export-ignore
/tests              export-ignore
/docs               export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore
/phpunit.xml.dist   export-ignore
/composer.lock      export-ignore

# Line Ending Normalization
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.php text eol=lf
