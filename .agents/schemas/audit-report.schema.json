{
    "$schema": "https:\/\/json-schema.org\/draft\/2020-12\/schema",
    "title": "Audit Report Schema",
    "type": "object",
    "required": [
        "audit_id",
        "target_artifact",
        "auditor_id",
        "status",
        "findings"
    ],
    "properties": {
        "audit_id": {
            "type": "string"
        },
        "target_artifact": {
            "type": "string"
        },
        "auditor_id": {
            "type": "string"
        },
        "status": {
            "type": "string",
            "enum": [
                "APPROVED",
                "REJECTED",
                "CONDITIONAL"
            ]
        },
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "severity",
                    "description",
                    "evidence"
                ],
                "properties": {
                    "severity": {
                        "type": "string",
                        "enum": [
                            "BLOCKER",
                            "CRITICAL",
                            "MAJOR",
                            "MINOR",
                            "INFO"
                        ]
                    },
                    "description": {
                        "type": "string"
                    },
                    "evidence": {
                        "type": "string"
                    }
                }
            }
        }
    }
}